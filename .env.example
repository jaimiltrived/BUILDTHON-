# Environment Configuration

# -----------------
# API CONFIGURATION
# -----------------
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# -----------------
# DATABASE
# -----------------
POSTGRES_USER=ftm_user
POSTGRES_PASSWORD=ftm_password
POSTGRES_DB=financial_time_machine
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------
# REDIS / CELERY
# -----------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# -----------------
# AUTHENTICATION
# -----------------
# Generate a secure key in production: openssl rand -hex 32
SECRET_KEY=dev_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------
# RATE LIMITING (login brute-force protection)
# -----------------
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# -----------------
# LOCAL AI CONFIGURATION
# -----------------
# For Ollama running on the host machine, usually localhost:11434 
# When accessing from inside a docker container, use host.docker.internal
OLLAMA_BASE_URL=http://host.docker.internal:11434
PRIMARY_MODEL=qwen3:4b
